{
  "name": "super-taki-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Super Taki rooms: one Durable Object per room code, and the object is the game. Zero cost.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test:coverage",
    "smoke": "node scripts/smoke.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
