{
  // One Durable Object per room code, and the object is the game: it holds every
  // hand, runs the rules and keeps every deadline on its single alarm.
  //
  // `name` and the `ROOM` binding are deliberately unchanged from when this was a
  // relay. The deployed URL, the `RELAY_URL` repository variable and every page
  // already built against it all point at `supertaki-relay`; renaming would break
  // the lot in exchange for a better word.
  //
  // Free plan throughout — Durable Objects here are SQLite-backed, which is the
  // variant the free tier includes, and hibernation is what keeps an idle room free.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supertaki-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
}
